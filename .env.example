# Copy to .env.local for `vercel dev`, and add the same values in
# Vercel → Project → Settings → Environment Variables for deployments.
# Never commit real values.

# ---- Firebase Admin (server only) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Google sign-in ----
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ---- OneSignal ----
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ---- Passkeys (WebAuthn) — server only ----
# Domain the passkeys belong to: the site's hostname, no https:// and no port.
# Passkeys only work on this domain (and its subdomains). Changing it later
# makes every registered passkey stop working.
WEBAUTHN_RP_ID=your-portal-domain.example
# Exact origin(s) users open the portal from, comma-separated, https only.
WEBAUTHN_ORIGINS=https://your-portal-domain.example
# Name shown in the browser's passkey prompt.
WEBAUTHN_RP_NAME=Dhyan Attendance
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it invalidates all registered passkeys (users simply add them again).
PASSKEY_SIGNING_SECRET=O4biwfuuC9B4KRmzoys7g3Hcluf425GAWeCXBiScW7Ev8bXmd9yuKkcx_oOH_bIU

# Local development: leave WEBAUTHN_RP_ID and WEBAUTHN_ORIGINS empty and the
# server uses localhost (ports 3000 and 5173). PASSKEY_SIGNING_SECRET is still required.